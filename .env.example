# Web (cloud) build configuration. Copy to `.env` and fill in.
# These are only used by the browser/web build — the desktop app ignores them
# and keeps using local SQLite + a locally stored TMDB key.

# Supabase project (Settings → API). Enables accounts + per-user cloud storage.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shared TMDB API key (v3 auth) used by all web users so they don't need their own.
# Get one free at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-v3-api-key
