# App configuration. Copy this file to `.env` and fill in the values.

# Supabase project (Settings → API). Enables accounts + per-user cloud storage.
# Leave these blank to run in guest-only mode (library saved in the browser).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Shared TMDB API key (v3 auth) used by all web users so they don't need their own.
# Get one free at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your-tmdb-v3-api-key
